POSTGRES_USER=teacher
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_language_teacher

# Claude (Anthropic API) powers the planner agents and the voice tutor.
CLAUDE_API_KEY=
# Optional model overrides (default: claude-haiku-5-5, effort low).
PLANNER_MODEL=
VOICE_LLM_MODEL=

# Speech for the voice tutor (en, es, de, fr): Soniox STT and Cartesia TTS.
SONIOX_API_KEY=
CARTESIA_API_KEY=

# LiveKit Cloud project used by the voice tutor (`lk project list`).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Langfuse observability (tracing), optional.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
