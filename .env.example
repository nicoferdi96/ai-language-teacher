POSTGRES_USER=teacher
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_language_teacher

# OpenRouter powers the Agno planner agents and the voice tutor LLM.
OPENROUTER_API_KEY=
# Optional model overrides (defaults: openai/gpt-5.4-nano). Models that accept
# temperature get 0.1; reasoning models (gpt-5/6) get minimal reasoning instead.
PLANNER_MODEL=
VOICE_LLM_MODEL=

# Gradium STT/TTS for the voice tutor (en, es, de, fr).
GRADIUM_API_KEY=

# LiveKit Cloud project used by the voice tutor (`lk project list`).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Langfuse observability (tracing), optional.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
