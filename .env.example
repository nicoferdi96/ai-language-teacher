POSTGRES_USER=teacher
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_language_teacher

# URL of the FastAPI lesson-planning microservice (POST {"user_id": <email>}).
# The frontend degrades gracefully with a gentle error if it is unreachable.
LESSON_PLANNER_URL=http://lesson-planner:8000/get_next_lesson/

# --- lesson-planner microservice credentials --------------------------------
# OpenRouter powers the Agno lesson-planning agent.
OPENROUTER_API_KEY=
# Tavily backs the agent's web-search tool.
TAVILY_API_KEY=
# Langfuse observability (tracing).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
